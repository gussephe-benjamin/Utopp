{
	"info": {
		"_postman_id": "utopp-api-collection",
		"name": "Utopp API",
		"description": "Colección completa de endpoints de la API de Utopp.\n\nFlujo recomendado:\n1. Registrar usuario (Auth o Google)\n2. Login para obtener token\n3. Completar onboarding\n4. Crear posts, imágenes, links\n5. Interactuar con feed, follows, participaciones\n\nEl token JWT se guarda automáticamente en la variable {{token}} al hacer login.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "user_id",
			"value": "1",
			"type": "string"
		},
		{
			"key": "post_id",
			"value": "1",
			"type": "string"
		},
		{
			"key": "image_id",
			"value": "1",
			"type": "string"
		},
		{
			"key": "link_id",
			"value": "1",
			"type": "string"
		},
		{
			"key": "role_id",
			"value": "1",
			"type": "string"
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Sistema",
			"description": "Health check y estado del servidor",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/health/",
							"host": ["{{base_url}}"],
							"path": ["health", ""]
						},
						"description": "GET /health — Verifica que la API esté funcionando correctamente."
					},
					"response": []
				}
			]
		},
		{
			"name": "Auth",
			"description": "Registro, login y refresh de tokens JWT",
			"item": [
				{
					"name": "Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    // Usuario creado exitosamente",
									"    pm.test('User created', function () {",
									"        var jsonData = pm.response.json();",
									"        pm.expect(jsonData.id).to.exist;",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"alumno@utec.edu.pe\",\n    \"password\": \"password123\",\n    \"full_name\": \"Juan Pérez\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": ["{{base_url}}"],
							"path": ["auth", "register"]
						},
						"description": "POST /auth/register — Registra un nuevo usuario con email UTEC, contraseña y nombre."
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('token', jsonData.access_token);",
									"    pm.test('Token saved', function () {",
									"        pm.expect(jsonData.access_token).to.exist;",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"alumno@utec.edu.pe\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						},
						"description": "POST /auth/login — Autentica con email y contraseña. Guarda el token automáticamente."
					},
					"response": []
				},
				{
					"name": "Refresh Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('token', jsonData.access_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/auth/refresh",
							"host": ["{{base_url}}"],
							"path": ["auth", "refresh"]
						},
						"description": "POST /auth/refresh — Genera un nuevo JWT para el usuario autenticado."
					},
					"response": []
				},
				{
					"name": "Auth Me",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/auth/me",
							"host": ["{{base_url}}"],
							"path": ["auth", "me"]
						},
						"description": "GET /auth/me — Devuelve id, email y estado de onboarding del usuario autenticado."
					},
					"response": []
				}
			]
		},
		{
			"name": "Google Auth",
			"description": "Registro y login con Google OAuth",
			"item": [
				{
					"name": "Google Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('token', jsonData.access_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"token\": \"GOOGLE_ID_TOKEN_AQUI\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/google/register",
							"host": ["{{base_url}}"],
							"path": ["google", "register"]
						},
						"description": "POST /google/register — Registra un usuario nuevo usando token de Google OAuth. Devuelve JWT."
					},
					"response": []
				},
				{
					"name": "Google Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('token', jsonData.access_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"token\": \"GOOGLE_ID_TOKEN_AQUI\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/google/login",
							"host": ["{{base_url}}"],
							"path": ["google", "login"]
						},
						"description": "POST /google/login — Autentica un usuario existente con token de Google. Devuelve JWT."
					},
					"response": []
				}
			]
		},
		{
			"name": "Onboarding",
			"description": "Flujo de onboarding del usuario",
			"item": [
				{
					"name": "Check Onboarding Status",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"id\": {{user_id}}\n}"
						},
						"url": {
							"raw": "{{base_url}}/onboarding/isComplete",
							"host": ["{{base_url}}"],
							"path": ["onboarding", "isComplete"]
						},
						"description": "POST /onboarding/isComplete — Verifica si el usuario ha completado el onboarding."
					},
					"response": []
				},
				{
					"name": "Onboarding Me",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/onboarding/me",
							"host": ["{{base_url}}"],
							"path": ["onboarding", "me"]
						},
						"description": "GET /onboarding/me — Devuelve el estado de onboarding del usuario autenticado."
					},
					"response": []
				},
				{
					"name": "Complete Onboarding",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"career\": \"Ingeniería de Software\",\n    \"interests\": [\"AI\", \"Web Dev\", \"Cloud\"],\n    \"availability\": 3,\n    \"cycle\": 5\n}"
						},
						"url": {
							"raw": "{{base_url}}/onboarding/update",
							"host": ["{{base_url}}"],
							"path": ["onboarding", "update"]
						},
						"description": "POST /onboarding/update — Completa el onboarding guardando career, interests, availability y cycle. Solo se ejecuta una vez."
					},
					"response": []
				}
			]
		},

							"raw": "{\n    \"title\": \"Hackathon UTEC 2025\",\n    \"description\": \"Evento de programación competitiva de 48 horas\",\n    \"post_type\": \"event\",\n    \"subtype\": \"hackathon\",\n    \"tags\": [\"programación\", \"competencia\", \"tech\"],\n    \"specific_fields\": {\n        \"location\": \"Campus UTEC\",\n        \"max_participants\": 100\n    },\n    \"deadline_at\": \"2025-12-31T23:59:59\"\n}"

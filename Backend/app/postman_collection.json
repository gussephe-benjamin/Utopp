		{
			"name": "Posts",
			"description": "CRUD de posts, publicación y archivado",
			"item": [
				{
					"name": "Create Post (Event)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('post_id', jsonData.id);",
									"    pm.test('Post created', function () {",
									"        pm.expect(jsonData.status).to.eql('draft');",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",

# ---------- POSTGRES ----------
# Este proyecto es dueño del contenedor de Postgres, compartido con Utopp
# Formulario a través del network externo 'utopp_default' (hostname: db).
# Estas credenciales son las del superusuario del contenedor: se usan para
# inicializar la base y para ejecutar la migración que crea los roles.
POSTGRES_USER=utopp_admin
POSTGRES_PASSWORD=CAMBIAR_ESTA_CLAVE
POSTGRES_DB=utopp_db
POSTGRES_PORT=5432

# ---------- BACKEND ----------
BACKEND_PORT=8000

# La app se conecta con su rol dedicado utopp_plataforma, no con el superusuario:
# es dueño del schema public y sobre el schema formulario solo tiene lectura y
# alta de eventos. Lo crea la migración Alembic 0003 del repo utopp-formulario.
# Dentro de Docker el host es el nombre del servicio: db
DATABASE_URL=postgresql+psycopg2://utopp_plataforma:CAMBIAR_ESTA_CLAVE@db:5432/utopp_db

# ---------- FRONTEND ----------
FRONTEND_PORT=5173

# URL del backend para el frontend
VITE_API_URL=http://localhost:8000

# Frontend de Utopp Formulario: destino del botón "Registrarme" de un evento
# Local:      http://localhost:5174
# Producción: https://www.formulario.utopp.app
VITE_UF_FRONTEND_URL=http://localhost:5174

# 🔐 Google OAuth (BACKEND)
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# 🔐 Google OAuth (FRONTEND)
VITE_GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com

# ---------- JWT (debe coincidir con Utopp Formulario para el SSO) ----------
SECRET_KEY=clave_secreta_aleatoria_muy_larga
JWT_SECRET_KEY=clave_secreta_aleatoria_muy_larga

# ---------- Cloudinary ----------
VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
VITE_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset

# =============================================================================
# Plantilla de variables para Render (copiar al panel Environment de cada servicio)
# Render inyecta RENDER_EXTERNAL_URL automáticamente en el servicio backend.
# Si GOOGLE_REDIRECT_URI / FRONTEND_URL siguen en localhost, el backend los corrige al arrancar.
# =============================================================================

# ── SERVICIO BACKEND (Render Web Service) ─────────────────────────────────────
#
# DATABASE_URL=postgresql://utopp_plataforma:...@<host-interno>/<db>
#   ↑ Misma instancia de Postgres que Utopp Formulario, distinto rol y schema.
#     Usar la Internal Database URL de Render (el host externo solo para
#     conexiones desde fuera de Render, y con sslmode=require).
#     El rol utopp_plataforma lo crea la migración Alembic 0003 del repo
#     utopp-formulario: es dueño del schema public y sobre el schema
#     formulario solo tiene USAGE + SELECT/INSERT en events y users.
# SECRET_KEY=genera_un_valor_largo_aleatorio
# JWT_SECRET_KEY=opcional_si_difiere_de_SECRET_KEY
#
# GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=tu_client_secret
# GOOGLE_REDIRECT_URI=https://www.api.utopp.app/auth/google/callback
# FRONTEND_URL=https://www.utopp.app
# UF_FRONTEND_URL=https://www.forms.utopp.app
#
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
#
# ALLOWED_ORIGINS=https://www.utopp.app,https://utopp.app,https://www.forms.utopp.app,https://forms.utopp.app
#
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
# SESSION_EXCHANGE_TOKEN_EXPIRE_SECONDS=120
# ENABLE_ADMIN_BOOTSTRAP=false
# BOOTSTRAP_ADMIN_TOKEN=

# ── SERVICIO FRONTEND (Render Static Site) ────────────────────────────────────
# Solo variables VITE_*. No pongas secretos de Google/Cloudinary aquí.
#
# VITE_API_URL=https://www.api.utopp.app
#   ↑ Debe ser www.api (no https://api.utopp.app: el apex hace 307 y rompe CORS
#     en POST /auth/session/exchange → pantalla blanca tras login).
# VITE_UF_FRONTEND_URL=https://www.forms.utopp.app
# VITE_CLOUDINARY_CLOUD_NAME=...
# VITE_CLOUDINARY_UPLOAD_PRESET=...
#
# Importante: VITE_* se embebe en el build. Tras cambiar estas variables, haz
# Manual Deploy / Clear build cache en Render.
#
# SPA rewrite (Redirects/Rewrites del Static Site):
#   Source /*  →  Destination /index.html  →  Action: Rewrite

# ── Google Cloud Console (manual, no es variable de entorno) ─────────────────
#
# Authorized redirect URIs:
#   - http://localhost:8000/auth/google/callback          (desarrollo local)
#   - https://www.api.utopp.app/auth/google/callback      (producción)
#
# Authorized JavaScript origins (opcional):
#   - https://www.utopp.app

# =============================================================================
# Plantilla de variables para Render (copiar al panel Environment de cada servicio)
# Render inyecta RENDER_EXTERNAL_URL automáticamente en el servicio backend.
# Si GOOGLE_REDIRECT_URI / FRONTEND_URL siguen en localhost, el backend los corrige al arrancar.
# =============================================================================

# ── SERVICIO BACKEND (Render Web Service) ─────────────────────────────────────
#
# DATABASE_URL=postgresql://...   (desde Render PostgreSQL o externo)
# SECRET_KEY=genera_un_valor_largo_aleatorio
# JWT_SECRET_KEY=opcional_si_difiere_de_SECRET_KEY
#
# GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=tu_client_secret
# GOOGLE_REDIRECT_URI=https://utopp.onrender.com/auth/google/callback
# FRONTEND_URL=https://www.utopp.app
# UF_FRONTEND_URL=https://www.formulario.utopp.app
#
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none
#
# ALLOWED_ORIGINS=https://www.utopp.app,https://www.formulario.utopp.app,https://formulario.utopp.app
#
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
# SESSION_EXCHANGE_TOKEN_EXPIRE_SECONDS=120
# ENABLE_ADMIN_BOOTSTRAP=false
# BOOTSTRAP_ADMIN_TOKEN=

# ── SERVICIO FRONTEND (Render Static Site o Web Service) ──────────────────────
#
# VITE_API_URL=https://utopp.onrender.com
# VITE_UF_FRONTEND_URL=https://www.formulario.utopp.app
# VITE_CLOUDINARY_CLOUD_NAME=...
# VITE_CLOUDINARY_UPLOAD_PRESET=...
#
# Importante: VITE_* se embebe en el build. Tras cambiar estas variables, haz
# Manual Deploy / Clear build cache en Render.

# ── Google Cloud Console (manual, no es variable de entorno) ─────────────────
#
# Authorized redirect URIs:
#   - http://localhost:8000/auth/google/callback          (desarrollo local)
#   - https://TU-BACKEND.onrender.com/auth/google/callback (producción)
#
# Authorized JavaScript origins (opcional):
#   - https://www.utopp.app
